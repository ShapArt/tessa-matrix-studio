{
  "name": "tessa-matrix-studio",
  "version": "1.17.1",
  "private": true,
  "description": "TESSA Matrix Studio userscript regression and safety verification",
  "scripts": {
    "build:production": "node tools/build-candidate.mjs --profile production --out dist/tessa-matrix-studio.user.js",
    "build:uat": "node tools/build-candidate.mjs --profile uat --out tessa-matrix-studio.user.js",
    "build": "npm run build:production && npm run build:uat",
    "pretest": "npm run build:uat",
    "test": "node --check tessa-matrix-studio.user.js && node tools/run-test-suite.mjs",
    "test:browser": "node tests/browser-exact-candidate.mjs && node tests/production-support-disclosure.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "playwright": "1.63.0"
  }
}
